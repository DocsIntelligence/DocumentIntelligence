generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════

enum Role {
  user
  admin
}

enum Provider {
  email
  google
  github
  linkedin
}

enum PaymentType {
  one_time
  subscription
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentGateway {
  razorpay
  stripe
}

enum PlanInterval {
  daily
  weekly
  monthly
  quarterly
  yearly
}

enum Feature {
  documents
  ai_tokens
  ai_attempts
  storage_mb
  api_calls
  // Document Intelligence: premium (paid agentic) extraction runs. Free plan = 0.
  premium_extraction
}

enum FeatureAction {
  reset
  increment
}

enum Currency {
  INR
  USD
  EUR
  CAD
  AUD
  GBP
}

enum DocumentStatus {
  draft
  in_review
  ready
  signed
  archived
}

enum DocumentOwnerType {
  user
  organisation
}

enum SignerRole {
  party_a
  party_b
  witness
  lawyer
  custom
}

enum SignerStatus {
  pending
  invited
  viewed
  signed
  declined
}

enum PageSize {
  a4
  legal
  foolscap
  stamp_paper_in_10
  stamp_paper_in_20
  stamp_paper_in_50
  stamp_paper_in_100
  stamp_paper_in_500
}

enum ShareMode {
  view
  comment
  edit
}

enum OrgRole {
  owner
  admin
  member
}

enum OrgType {
  agency
  law_firm
  individual_lawyer
}

// ═══════════════════════════════════════════════════════════════════
// MODELS
// ═══════════════════════════════════════════════════════════════════

// ─── User ──────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  username      String   @unique
  picture       String?
  provider      Provider @default(email)
  role          Role     @default(user)
  emailVerified Boolean  @default(false)
  locale        String   @default("en-US")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  secrets    Secrets?
  identities UserIdentity[]
  passkeys   Passkey[]
  wallet     UserWallet?
  payments   Payment[]

  // Documents domain
  ownedDocuments    Document[]         @relation("DocumentOwnerUser")
  documentVersions  DocumentVersion[]
  documentShares    DocumentShare[]
  documentComments  DocumentComment[]
  orgMemberships    OrgMember[]
  authoredTemplates DocumentTemplate[] @relation("TemplateAuthor")
  brandingProfile   BrandingProfile?

  // Document Intelligence domain (separate; see docs/05)
  sourceDocuments SourceDocument[] @relation("SourceDocOwnerUser")

  @@index([email])
}

// ─── Secrets (1:1 with User) ───────────────────────────────────

model Secrets {
  id                  String    @id @default(cuid())
  userId              String    @unique
  password            String?
  refreshToken        String?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  verificationToken   String?
  lastSignedIn        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── OAuth Identities ──────────────────────────────────────────

model UserIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          Provider
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

// ─── Passkeys (WebAuthn) ───────────────────────────────────────

model Passkey {
  id           String   @id @default(cuid())
  credentialId String   @unique
  publicKey    Bytes
  counter      BigInt   @default(0)
  deviceType   String?
  backedUp     Boolean  @default(false)
  transports   String[] @default([])
  label        String?
  userId       String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Challenge Store (for WebAuthn) ────────────────────────────

model Challenge {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Plans ─────────────────────────────────────────────────────

model Plan {
  id              String       @id @default(cuid())
  name            String
  description     String?
  type            PaymentType  @default(one_time)
  duration        Int          @default(1)
  interval        PlanInterval @default(monthly)
  price           Int          @default(0)
  originalPrice   Int?
  discountLabel   String?
  priceMultiplier Int          @default(100)
  currency        Currency     @default(INR)
  active          Boolean      @default(true)
  gatewayPlanId   String?
  totalCycleCount Int?         @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  features PlanFeature[]
  wallets  UserWallet[]
}

model PlanFeature {
  id          String        @id @default(cuid())
  name        Feature
  action      FeatureAction @default(reset)
  quantity    Int           @default(0) // -1 = unlimited
  description String?

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([name, planId])
}

// ─── Wallet ────────────────────────────────────────────────────

model UserWallet {
  id          String      @id @default(cuid())
  paymentType PaymentType @default(one_time)
  active      Boolean     @default(false)
  startAt     DateTime
  endAt       DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  usage WalletUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletUsage {
  id       String  @id @default(cuid())
  name     Feature
  quantity Int     @default(0) // -1 = unlimited
  consumed Int     @default(0)

  userWalletId String
  wallet       UserWallet @relation(fields: [userWalletId], references: [id], onDelete: Cascade)

  @@unique([name, userWalletId])
}

// ─── Payments ──────────────────────────────────────────────────

model Payment {
  id                    String         @id @default(cuid())
  gateway               PaymentGateway @default(razorpay)
  gatewayPaymentId      String?        @unique
  gatewayOrderId        String?
  gatewaySubscriptionId String?
  status                PaymentStatus  @default(pending)
  amount                Int?
  currency              Currency?
  initiatedAt           DateTime?
  confirmedAt           DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wallets UserWallet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Lookups (configurable dropdowns / reference data) ─────────

model LookupGroup {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  description String?
  isPublic    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values LookupValue[]
}

model LookupValue {
  id        String  @id @default(cuid())
  label     String
  value     String?
  order     Int     @default(0)
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)
  metadata  Json?

  groupId String
  group   LookupGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, value])
}

// ─── Mail Queue & Logs ─────────────────────────────────────────

model MailLog {
  id        String    @id @default(cuid())
  to        String
  subject   String
  template  String?
  body      String?
  status    String    @default("queued") // "queued" | "sent" | "failed"
  attempts  Int       @default(0)
  error     String?
  metadata  Json?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// DOCUMENTS DOMAIN
// ═══════════════════════════════════════════════════════════════════

// ─── DocumentType ──────────────────────────────────────────────
// Registry entry for a kind of legal document (e.g. rent_agreement, rti).
// The actual form schema lives in libs/document-schema; the JSON column
// stores a serialized snapshot for runtime-only validation contexts.

model DocumentType {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  category        String
  description     String?
  schema          Json
  defaultPageSize PageSize @default(a4)
  jurisdictions   String[]
  iconKey         String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  templates DocumentTemplate[]
  documents Document[]

  @@index([category])
}

// ─── DocumentTemplate ──────────────────────────────────────────
// One style/variant of a DocumentType. Multiple templates per type.

model DocumentTemplate {
  id             String             @id @default(cuid())
  documentTypeId String
  key            String
  name           String
  componentKey   String
  thumbnailKey   String?
  jurisdictions  String[]
  language       String             @default("en")
  styleTokens    Json?
  isPremium      Boolean            @default(false)
  isActive       Boolean            @default(true)
  ownerType      DocumentOwnerType?
  ownerUserId    String?
  ownerOrgId     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  documentType DocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  ownerUser    User?         @relation("TemplateAuthor", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerOrg     Organisation? @relation(fields: [ownerOrgId], references: [id], onDelete: SetNull)
  documents    Document[]

  @@unique([documentTypeId, key])
  @@index([ownerType, ownerUserId])
  @@index([ownerType, ownerOrgId])
}

// ─── Document ──────────────────────────────────────────────────
// A user's instance of a DocumentType. data is the validated form values.

model Document {
  id             String            @id @default(cuid())
  title          String
  status         DocumentStatus    @default(draft)
  documentTypeId String
  templateId     String
  ownerType      DocumentOwnerType @default(user)
  ownerUserId    String?
  ownerOrgId     String?
  data           Json
  pageSize       PageSize          @default(a4)
  language       String            @default("en")
  jurisdiction   String?
  lockedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  documentType DocumentType     @relation(fields: [documentTypeId], references: [id])
  template     DocumentTemplate @relation(fields: [templateId], references: [id])
  ownerUser    User?            @relation("DocumentOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerOrg     Organisation?    @relation(fields: [ownerOrgId], references: [id], onDelete: SetNull)

  versions DocumentVersion[]
  shares   DocumentShare[]
  signers  DocumentSigner[]
  exports  DocumentExport[]
  comments DocumentComment[]

  @@index([ownerUserId, updatedAt])
  @@index([ownerOrgId, updatedAt])
  @@index([documentTypeId])
  @@index([status])
}

// ─── DocumentVersion ───────────────────────────────────────────
// Immutable snapshot of Document.data at a point in time.

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  data        Json
  templateId  String
  pageSize    PageSize
  label       String?
  createdById String?
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
}

// ─── DocumentShare ─────────────────────────────────────────────

model DocumentShare {
  id           String    @id @default(cuid())
  documentId   String
  token        String    @unique
  mode         ShareMode @default(view)
  passwordHash String?
  expiresAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ─── DocumentSigner ────────────────────────────────────────────

model DocumentSigner {
  id         String       @id @default(cuid())
  documentId String
  email      String?
  name       String
  role       SignerRole
  status     SignerStatus @default(pending)
  order      Int          @default(0)
  provider   String? // "aadhaar_esign" | "draw" | "typed" | "dsc"
  evidence   Json? // OTP txn id, certificate, IP, geolocation
  signedAt   DateTime?
  invitedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, order])
  @@index([status])
}

// ─── DocumentExport ────────────────────────────────────────────

model DocumentExport {
  id         String   @id @default(cuid())
  documentId String
  format     String // "pdf" | "docx" | "png"
  pageSize   PageSize
  status     String   @default("pending") // "pending" | "ready" | "failed"
  s3Key      String?
  byteSize   Int?
  checksum   String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

// ─── DocumentComment ───────────────────────────────────────────

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  authorId   String?
  authorName String
  anchor     Json
  body       String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([documentId])
}

// ─── Organisation ──────────────────────────────────────────────

model Organisation {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  type       OrgType  @default(agency)
  brandingId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members   OrgMember[]
  branding  BrandingProfile?   @relation(fields: [brandingId], references: [id])
  documents Document[]
  templates DocumentTemplate[]

  // Document Intelligence domain (separate; see docs/05)
  sourceDocuments SourceDocument[]

  @@index([slug])
}

model OrgMember {
  id     String  @id @default(cuid())
  orgId  String
  userId String
  role   OrgRole @default(member)

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model BrandingProfile {
  id               String   @id @default(cuid())
  ownerUserId      String?  @unique
  logoS3Key        String?
  letterheadS3Key  String?
  primaryColor     String?
  footerText       String?
  barCouncilNumber String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerUser    User?         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  organisation Organisation?
}

// ═══════════════════════════════════════════════════════════════════
// DOCUMENT INTELLIGENCE (docs/05) — separate domain. Reads an EXISTING
// document, understands it (classify → extract → analyse), and (Phase 3)
// converts it via the public document-create API. Never edits Document/
// DocumentVersion/editor. All structured values use jsonb (no JSON-as-string).
// ═══════════════════════════════════════════════════════════════════

enum SourceDocStatus {
  uploaded
  processing
  processed
  failed
}

enum IntelligenceJobStatus {
  queued
  processing
  needs_review
  completed
  failed
}

/// Pipeline stages (docs/05 §4). A simple linear state machine for v1; the
/// process-as-data workflow engine is deferred to Phase 4.
enum IntelligenceStage {
  uploaded
  normalize
  classify
  extract
  analyse
  review
  convert
}

/// Which extraction engine to use. `auto` = native-text fast path, escalating
/// to vlm (scanned) or agentic (premium) as needed/entitled. `native`/`vlm`/
/// `agentic` force a specific tier. `agentic` requires the premium entitlement.
enum ExtractionEngineMode {
  auto
  native
  vlm
  agentic
}

/// An uploaded file to be understood. Stored privately (StorageService key);
/// `normalizedText` holds per-page text/layout once OCR/parse completes.
model SourceDocument {
  id             String          @id @default(cuid())
  ownerUserId    String?
  ownerOrgId     String?
  filename       String
  contentType    String
  byteSize       Int?
  checksum       String?
  s3Key          String // private storage key
  pageCount      Int?
  language       String? // detected primary language, e.g. "hi" / "en"
  status         SourceDocStatus @default(uploaded)
  /// Per-page normalized text/layout: [{ page, text, blocks? }]. jsonb.
  normalizedText Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  ownerUser User?         @relation("SourceDocOwnerUser", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerOrg  Organisation? @relation(fields: [ownerOrgId], references: [id], onDelete: SetNull)

  jobs         IntelligenceJob[]
  extractions  Extraction[]
  analyses     AnalysisRun[]
  chunks       SourceChunk[]
  pipelineRuns PipelineRun[]

  @@index([ownerUserId, updatedAt])
  @@index([ownerOrgId, updatedAt])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// PIPELINE ENGINE (docs/07) — configurable, per-org, process-as-data.
// A Pipeline is an ordered list of typed Stages; a PipelineRun walks one
// SourceDocument through them, each entry recorded as a StageExecution.
// P4.1 = engine core (single-doc; batch/DB-schema-authoring/review-queue
// are later phases). Additive — the legacy IntelligenceJob flow is untouched.
// ═══════════════════════════════════════════════════════════════════

enum PipelineStageType {
  ingest
  classify
  filter // classification gate: keep wanted types, archive the rest
  extract
  validate
  review
  export
}

enum PipelineRunStatus {
  queued
  running
  needs_review
  approved
  completed
  failed
  rejected
  archived // intentionally not extracted (type out of scope, or manually skipped)
}

enum BatchStatus {
  running
  needs_review
  completed
  failed
}

enum BatchSource {
  multi_file
  zip
  s3_prefix
  api
}

/// A set of documents run through one pipeline together (docs/07 §5). P4.3 =
/// multi-file upload; zip/s3/api are deferred behind the same fan-out seam.
model Batch {
  id          String      @id @default(cuid())
  ownerUserId String?
  ownerOrgId  String?
  pipelineId  String
  name        String?
  source      BatchSource @default(multi_file)
  status      BatchStatus @default(running)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  runs PipelineRun[]

  @@index([ownerUserId, createdAt])
  @@index([ownerOrgId, createdAt])
}

model Pipeline {
  id         String   @id @default(cuid())
  ownerOrgId String? // null = system default (template); else org-owned
  key        String
  name       String
  version    Int      @default(1) // immutable versions; new edit = new version
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stages PipelineStage[]
  runs   PipelineRun[]

  @@unique([ownerOrgId, key, version])
  @@index([ownerOrgId])
}

model PipelineStage {
  id         String            @id @default(cuid())
  pipelineId String
  order      Int
  type       PipelineStageType
  name       String
  /// Stage config jsonb: autoAdvance condition, engineMode, schemaKey, targets…
  config     Json              @default("{}")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, order])
}

model PipelineRun {
  id               String            @id @default(cuid())
  pipelineId       String
  batchId          String?
  sourceDocumentId String
  currentStageId   String?
  status           PipelineRunStatus @default(queued)
  documentTypeKey  String? // classifier result, denormalized for funnel + filter
  archivedReason   String? // why this run was archived (type out of scope / manual)
  error            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  pipeline       Pipeline         @relation(fields: [pipelineId], references: [id])
  batch          Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sourceDocument SourceDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  executions     StageExecution[]

  @@index([pipelineId, status])
  @@index([batchId])
  @@index([sourceDocumentId])
  @@index([status])
}

model StageExecution {
  id            String            @id @default(cuid())
  pipelineRunId String
  stageId       String
  stageType     PipelineStageType
  status        String            @default("queued") // queued|running|passed|parked|failed
  score         Float? // the stage's computed score (auto-advance audit)
  output        Json? // stage result (classification/extraction/etc.)
  error         String?
  attempts      Int               @default(0)
  heartbeatAt   DateTime? // reconciler watches this
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId])
  @@index([status, heartbeatAt])
}

// ═══════════════════════════════════════════════════════════════════
// PIPELINE CONFIG-AS-DATA (docs/07 §3, P4.2) — DB-authored extraction
// schemas + field-maps, org-scoped + versioned. The in-code
// @org/doc-intelligence registry seeds `ownerOrgId = null` templates; a
// SchemaResolverService prefers a DB row (org → template) and falls back to
// the code registry. Editing mints a NEW version (immutable); in-flight runs
// keep their pinned version. `ownerOrgId` follows the Pipeline convention:
// a plain nullable string + index, no FK to Organisation.
// ═══════════════════════════════════════════════════════════════════

/// A DB-authored ExtractionSchema (mirror of the in-code @org/doc-intelligence
/// `ExtractionSchema`). Suffixed `Def` to avoid clashing with the TS type.
model ExtractionSchemaDef {
  id              String   @id @default(cuid())
  ownerOrgId      String? // null = system template (seeded from code registry)
  key             String
  name            String
  version         Int      @default(1) // immutable; a new edit = a new version
  documentTypeKey String? // shared vocab w/ the drafting bundle (docs/05 §11.2)
  description     String?
  jurisdiction    String? // variant tag, e.g. "IN-MH"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fields SchemaField[]

  @@unique([ownerOrgId, key, version])
  @@index([ownerOrgId, key])
}

/// One field of an ExtractionSchemaDef (mirror of `ExtractionField`).
model SchemaField {
  id              String  @id @default(cuid())
  schemaId        String
  key             String
  label           String
  type            String  @default("string") // string|number|currency|date|boolean|enum|table
  required        Boolean @default(false)
  reviewMandatory Boolean @default(false)
  isActive        Boolean @default(true) // soft-disable: inactive fields aren't extracted/reviewed
  fieldThreshold  Float? // per-field auto-advance override
  description     String? // natural-language guidance fed to the model
  example         String?
  format          String? // "DD/MM/YYYY", "INR", "+91 ##########"
  /// enumValues (enum) / columns (table) jsonb — anything beyond scalar meta.
  config          Json?
  order           Int     @default(0)

  schema ExtractionSchemaDef @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@unique([schemaId, key])
  @@index([schemaId])
}

/// A DB-authored FieldMap (mirror of @org/doc-intelligence `FieldMap`): routes a
/// known type's extraction keys into its DocumentTypeBundle path on convert.
model FieldMapDef {
  id              String   @id @default(cuid())
  ownerOrgId      String?
  schemaKey       String
  documentTypeKey String
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entries FieldMapEntry[]

  @@unique([ownerOrgId, schemaKey, version])
  @@index([ownerOrgId, schemaKey])
}

model FieldMapEntry {
  id            String @id @default(cuid())
  fieldMapId    String
  extractionKey String // flat extraction field key (e.g. "landlord_name")
  bundlePath    String // dot-path into the bundle (e.g. "parties.landlord.name")

  fieldMap FieldMapDef @relation(fields: [fieldMapId], references: [id], onDelete: Cascade)

  @@unique([fieldMapId, extractionKey])
  @@index([fieldMapId])
}

/// Phase 2 analysis (docs/05 §7): summary / parties / obligations / key dates /
/// risk flags, plus cited-law health (repealed-citation findings verified
/// against @org/legal-reference — the AI never asserts citations itself). All
/// structured output is jsonb.
model AnalysisRun {
  /// Polymorphic subject (docs/09 #6): analyse/ask works on uploaded sources
  /// AND drafting documents. subjectType ∈ {'source','document'}; subjectId is
  /// the SourceDocument.id or Document.id. `sourceDocumentId` is retained (now
  /// nullable) for the SourceDocument relation + back-compat on existing rows.
  id               String   @id @default(cuid())
  subjectType      String   @default("source")
  subjectId        String?
  sourceDocumentId String?
  /// sha256 of the analyzed text — dedupe cache (reuse instead of recompute).
  contentHash      String?
  summary          String?
  /// [{ name, role }]
  parties          Json?
  /// [{ label, date }]
  keyDates         Json?
  /// [{ party, obligation }]
  obligations      Json?
  /// [{ severity, note }]
  riskFlags        Json?
  /// CitationFinding[] from @org/legal-reference (repealed IPC/CrPC/Evidence Act).
  citationFindings Json?
  createdAt        DateTime @default(now())

  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId, createdAt])
  @@index([subjectType, subjectId, createdAt])
}

/// Phase 2 RAG (docs/05 §7): per-page text chunks + embeddings for "ask this
/// document" with page-cited answers. Single-document retrieval, so cosine is
/// computed in-process over the doc's chunks (no pgvector needed for v1); the
/// embedding is stored as a float array.
model SourceChunk {
  id               String   @id @default(cuid())
  /// Polymorphic subject — see AnalysisRun. For documents `page` is 1.
  subjectType      String   @default("source")
  subjectId        String?
  sourceDocumentId String?
  page             Int
  ordinal          Int // chunk order within the page
  text             String
  embedding        Float[]
  createdAt        DateTime @default(now())

  sourceDocument SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  @@index([sourceDocumentId])
  @@index([subjectType, subjectId])
}

/// One processing run over a SourceDocument. Idempotent + stage-guarded; the
/// reconciler cron sweeps rows whose `heartbeatAt` went stale while processing.
model IntelligenceJob {
  id               String                @id @default(cuid())
  sourceDocumentId String
  status           IntelligenceJobStatus @default(queued)
  stage            IntelligenceStage     @default(uploaded)
  /// Requested engine tier (auto unless the caller forced one).
  engineMode       ExtractionEngineMode  @default(auto)
  /// The engine actually used (native-text / vlm / agentic provider name).
  engineUsed       String?
  /// Classifier output — the generator's DocumentType key when matched (§11.2).
  documentTypeKey  String?
  /// Per-step model attribution + cost/latency telemetry. jsonb.
  telemetry        Json?
  error            String?
  attempts         Int                   @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  /// Liveness beat written during processing; the reconciler uses it.
  heartbeatAt      DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  extraction     Extraction?

  @@index([status, heartbeatAt])
  @@index([sourceDocumentId])
}

/// Structured result of extracting a SourceDocument against an ExtractionSchema.
/// Every field carries confidence + provenance (page/bbox); human edits are
/// recorded in `edits` (originalValue/editedBy) — the audit trail (docs/05 §1).
model Extraction {
  id                String    @id @default(cuid())
  sourceDocumentId  String
  jobId             String?   @unique
  /// ExtractionSchema identity; equals DocumentType.key when a known type.
  schemaKey         String
  documentTypeKey   String?
  /// Structured field values: { fieldPath: value }. jsonb.
  fields            Json
  /// Per-field confidence + provenance: { fieldPath: { confidence, page, bbox, source } }. jsonb.
  confidence        Json
  /// Overall confidence 0..1 — drives review routing / straight-through (STP).
  overallConfidence Float?
  reviewed          Boolean   @default(false)
  reviewedByUserId  String?
  reviewedAt        DateTime?
  /// Provenance of every human edit: [{ fieldPath, originalValue, newValue, editedBy, at }]. jsonb.
  edits             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sourceDocument SourceDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  job            IntelligenceJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([sourceDocumentId])
  @@index([schemaKey])
}

// ═══════════════════════════════════════════════════════════════════
// SEARCH (docs/09) — unified full-text + semantic index across both worlds
// ═══════════════════════════════════════════════════════════════════

/// One row per searchable entity, spanning the drafting world (`Document`) and
/// the intelligence world (`SourceDocument`). Keyword search uses the generated
/// `tsv` (tsvector, GIN-indexed); semantic search uses `embedding` (pgvector,
/// HNSW-indexed). The `tsv` column + both GIN indexes + the `vector` column are
/// created via raw SQL in the migration (Prisma can't express generated columns
/// or pgvector indexes). Maintained asynchronously (SEARCH_QUEUE) with an inline
/// fallback when Redis is absent. `contentHash` lets the indexer skip
/// re-embedding when the extracted text has not changed. See SearchIndexService.
model SearchIndex {
  id           String                       @id @default(cuid())
  /// 'document' (drafting) | 'source' (uploaded/intelligence)
  kind         String
  /// Document.id or SourceDocument.id
  refId        String
  ownerUserId  String?
  ownerOrgId   String?
  title        String                       @default("")
  bodyText     String                       @default("")
  /// Generated tsvector(setweight(title,'A') || setweight(bodyText,'B')). GIN.
  tsv          Unsupported("tsvector")?
  /// pgvector embedding of bodyText (text-embedding-3-small ⇒ 1536). HNSW. Null until embedded.
  embedding    Unsupported("vector(1536)")?
  /// sha256(title + '\n' + bodyText) — skip re-embedding unchanged text.
  contentHash  String                       @default("")
  /// documentTypeKey / schemaKey for filtering.
  type         String?
  status       String?
  /// updatedAt of the indexed row (for recency ranking / display).
  refUpdatedAt DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@unique([kind, refId])
  @@index([ownerUserId])
  @@index([ownerOrgId])
  @@index([kind])
}

/// Per-organisation search configuration (process-as-data, mirrors Pipeline).
/// `ownerOrgId = null` is the single system-default row (managed by
/// SearchConfigService); org rows override it field-by-field. Lets search be a
/// configurable product surface (admin UI) rather than hardcoded constants.
model SearchConfig {
  id              String   @id @default(cuid())
  /// null = system default; otherwise the owning org. One row per org.
  ownerOrgId      String?  @unique
  /// Hybrid blend weights: score = keywordWeight*kwNorm + semanticWeight*cosNorm.
  keywordWeight   Float    @default(0.5)
  semanticWeight  Float    @default(0.5)
  /// Enable the semantic (pgvector) leg; false ⇒ keyword-only.
  semanticEnabled Boolean  @default(true)
  /// Searchable kinds: subset of ['document','source'].
  enabledKinds    String[] @default(["document", "source"])
  /// pg_trgm similarity threshold for the fuzzy title fallback (0..1).
  fuzzyThreshold  Float    @default(0.3)
  /// How much fresher documents rank above older ones (0 = ignore recency,
  /// 1 = rank purely by recency). Blended after the keyword/semantic relevance.
  recencyWeight   Float    @default(0.2)
  /// ts_headline snippet length, in words.
  snippetWords    Int      @default(30)
  /// Embedding model id (must match a configured AI provider embedding model).
  embeddingModel  String   @default("text-embedding-3-small")
  /// Hard cap on results regardless of the page request.
  maxResults      Int      @default(200)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════
// DOCUMENT VAULT (docs/10) — entities + their documents, encrypted at rest
// ═══════════════════════════════════════════════════════════════════

/// A party the user manages (themself, spouse, a company, a landlord, …). Its
/// structured fields (Aadhaar/PAN/address/…) are stored encrypted in
/// `dataEncrypted` (AES-256-GCM) — plaintext field values never hit a column.
/// Feeds document autofill. Owner/org-scoped like Document.
model VaultEntity {
  id            String   @id @default(cuid())
  ownerUserId   String?
  ownerOrgId    String?
  /// 'person' | 'company' | 'lawyer' | 'court' | 'case' | 'property' | 'other'
  /// Free-form string (not a Prisma enum) so new kinds ship without migrations.
  kind          String   @default("person")
  /// Display label (user-chosen, e.g. "Myself", "Acme Pvt Ltd"). Not a secret.
  label         String
  /// Disabled entities are hidden from autofill + muted in the list (soft state).
  isActive      Boolean  @default(true)
  /// AES-256-GCM ciphertext of the canonical fields JSON: "iv:tag:ciphertext" (base64). Null = no fields yet.
  dataEncrypted String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents  VaultDocument[]
  accessLogs VaultAccessLog[]

  @@index([ownerUserId, updatedAt])
  @@index([ownerOrgId, updatedAt])
}

/// An original document attached to an entity (Aadhaar card scan, PAN, etc.).
/// Bytes live in S3 (private); only short-lived presigned URLs are issued.
model VaultDocument {
  id          String   @id @default(cuid())
  entityId    String
  /// 'aadhaar' | 'pan' | 'passport' | 'incorporation' | 'gst' | 'other'
  kind        String   @default("other")
  filename    String
  contentType String
  byteSize    Int?
  s3Key       String
  checksum    String?
  createdAt   DateTime @default(now())

  entity VaultEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

/// Admin-configurable vault entity kind catalog (docs/10). A kind is the
/// "person / company / lawyer / court / case / property / other" notion
/// — what the user is storing. Fields are global and many-to-many linked
/// to kinds via VaultEntityKindField so e.g. `aadhaar_number` is one row
/// reused by Person + Lawyer + … instead of duplicated per kind.
model VaultEntityKindConfig {
  id           String   @id @default(cuid())
  ownerOrgId   String?
  /// Stable key (e.g. 'person', 'lawyer'). Lowercase, [a-z0-9_].
  key          String
  label        String
  /// One of: 'primary' | 'secondary' | 'info' | 'warning' | 'success'.
  /// Drives the row/detail badge colour in the UI.
  badgeVariant String   @default("secondary")
  sortOrder    Int      @default(0)
  /// System kinds (seeded from code) can be disabled but not deleted.
  isSystem     Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fieldLinks VaultEntityKindField[]

  @@unique([ownerOrgId, key])
  @@index([ownerOrgId, sortOrder])
}

/// Admin-configurable vault field catalog (docs/10): the global pool of
/// canonical fields. A field row exists once and is mapped to one or more
/// entity kinds via VaultEntityKindField — so `pan` is a single row used
/// by Person + Company + Lawyer + Other (no duplication). `key` stays a
/// stable identifier so document autofill keeps working.
model VaultFieldConfig {
  id          String   @id @default(cuid())
  ownerOrgId  String?
  /// Stable canonical key (e.g. 'aadhaar_number'). Don't rename — autofill maps to it.
  key         String
  label       String
  /// 'text'|'textarea'|'date'|'number'|'tel'|'email'|'select'|'lookup'
  type        String   @default("text")
  /// Default group label; per-kind overrides live on VaultEntityKindField.
  group       String?
  options     String[] @default([])
  /// When type='lookup', the LookupGroup key to pull options from (e.g. 'country').
  lookupKey   String?
  sensitive   Boolean  @default(false)
  revealLast  Int?
  placeholder String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kindLinks VaultEntityKindField[]

  @@unique([ownerOrgId, key])
  @@index([ownerOrgId])
}

/// Many-to-many join: which fields each entity kind exposes, in what order,
/// optionally re-grouped per kind. `groupOverride` lets one canonical field
/// (e.g. `pan`) sit under "Identity" for a person and "Practice" for a lawyer
/// without forking the field row.
model VaultEntityKindField {
  id            String   @id @default(cuid())
  entityKindId  String
  fieldId       String
  sortOrder     Int      @default(0)
  groupOverride String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  entityKind VaultEntityKindConfig @relation(fields: [entityKindId], references: [id], onDelete: Cascade)
  field      VaultFieldConfig      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([entityKindId, fieldId])
  @@index([entityKindId, sortOrder])
}

/// Admin-configurable document kinds (Aadhaar/PAN/…) + which canonical fields a
/// scan of each can autofill. `ownerOrgId = null` = system default.
model VaultDocKindConfig {
  id         String   @id @default(cuid())
  ownerOrgId String?
  kind       String
  label      String
  /// Canonical field keys this document can populate via scan-autofill.
  fills      String[] @default([])
  scannable  Boolean  @default(true)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerOrgId, sortOrder])
}

/// Security audit trail — who revealed / downloaded / changed an entity's data.
model VaultAccessLog {
  id        String   @id @default(cuid())
  entityId  String
  userId    String
  /// 'create' | 'update' | 'reveal' | 'download' | 'delete'
  action    String
  detail    String?
  createdAt DateTime @default(now())

  entity VaultEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// AI USAGE LEDGER — one row per LLM/vendor call (success or failure)
// ═══════════════════════════════════════════════════════════════════

/// Append-only audit ledger of every AI / LLM / vendor-AI invocation across
/// the system. Modelled after Langfuse "generations" + Helicone "requests" +
/// OpenLLMetry `gen_ai.*` semantic conventions: every dimension a rollup might
/// need is denormalised onto the row so a single well-indexed table powers
/// user / org / document / source / run / extraction / batch / session /
/// trace / per-model / per-day dashboards — no extra rollup tables, no joins
/// at query time. Written by `AiUsageRecorderService` from the chokepoint in
/// `AiService.{generate,stream,extract,embed}` (and vendor adapters such as
/// LlamaParse / Reducto whose "tokens" unit is pages, not tokens).
model AiUsage {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  /// When the AI call returned (success or error). Null on still-streaming rows.
  finishedAt DateTime?

  // ── Who ─────────────────────────────────────────────────────────
  /// Acting user (null for system/cron jobs like a backfill reindex).
  userId    String?
  /// Tenant. Denormalised so org-level rollups don't need to join through user.
  orgId     String?
  /// Group N calls in one user "session" (chat conversation, drafting session,
  /// review session). Free-form id minted by the caller.
  sessionId String?

  // ── Trace hierarchy (Langfuse-style) ────────────────────────────
  /// Parent trace id. An "extract" trace might fan out into classify + extract +
  /// critique sub-calls — same `traceId` on all three, with `parentSpanId`
  /// linking children to their parent within the trace.
  traceId      String?
  parentSpanId String?

  // ── What ────────────────────────────────────────────────────────
  /// Logical operation. Keep in sync with `AI_OPERATIONS` in code.
  /// 'classify' | 'extract' | 'critique' | 'generate' | 'revise' | 'analyse'
  /// | 'ask' | 'embed' | 'parse' | 'rerank' | 'moderate' | 'vision' | 'tts'
  /// | 'stt' | 'tool_call'.
  operation   String
  /// Product-feature attribution for per-feature billing dashboards.
  /// 'doc.draft.legal_notice' | 'intel.classify' | 'intel.extract.invoice'
  /// | 'intel.analyse' | 'intel.ask' | 'search.embed' | …
  featureCode String?

  // ── Model identity ─────────────────────────────────────────────
  /// 'openai' | 'anthropic' | 'google' | 'llamaparse' | 'reducto' | …
  provider     String
  /// e.g. 'claude-haiku-4-5-20251001', 'gpt-5o', 'text-embedding-3-small'.
  model        String
  /// Surface-pinned snapshot when the provider exposes one (e.g. dated alias).
  modelVersion String?

  // ── Related entities (any combo set; all indexed) ──────────────
  /// Drafting document (Documents world).
  documentId       String?
  /// Uploaded source (Intelligence world).
  sourceDocumentId String?
  /// Pipeline run (one per uploaded doc through a pipeline).
  pipelineRunId    String?
  /// Extraction record (one per successful extract).
  extractionId     String?
  /// Analysis run (analyse / ask).
  analysisRunId    String?
  /// Batch (groups N pipeline runs from a single multi-file upload).
  batchId          String?

  // ── Token measurements ─────────────────────────────────────────
  inputTokens       Int @default(0)
  outputTokens      Int @default(0)
  /// Anthropic cache-read input tokens (charged at a discount).
  cachedInputTokens Int @default(0)
  /// Anthropic cache-write input tokens (charged at a premium).
  cacheWriteTokens  Int @default(0)
  /// Reasoning / "thinking" tokens (OpenAI o-series, Anthropic extended
  /// thinking, Gemini "thoughts") — separate billing tier on some models.
  reasoningTokens   Int @default(0)
  totalTokens       Int @default(0)

  // ── Alternate billable units (pages, requests, characters, seconds) ──
  /// LlamaParse / Reducto bill per page; image OCR per image; TTS per char.
  /// Use this when `unitType != 'tokens'`. Cost engine multiplies by the
  /// matching pricing row.
  unitsUsed Int    @default(0)
  unitType  String @default("tokens")

  // ── File / payload sizes (debugging, not billing) ──────────────
  inputBytes  Int?
  outputBytes Int?

  // ── Cost ───────────────────────────────────────────────────────
  /// Cost in USD computed at call time from the pricing row in effect.
  estimatedCostUsd Decimal @default(0) @db.Decimal(12, 6)
  /// FK into `AiModelPricing.id` so finance can reconcile against the exact
  /// rate-card row that was applied (rate cards change; rows are immutable).
  pricingId        String?

  // ── Latency ────────────────────────────────────────────────────
  durationMs            Int  @default(0)
  /// Time-to-first-token for streaming calls (null for non-streaming).
  latencyToFirstTokenMs Int?
  /// Time spent queued before the request started (provider rate-limit waits).
  queuedMs              Int?

  // ── Outcome ────────────────────────────────────────────────────
  /// 'success' | 'error' | 'timeout' | 'rate_limited' | 'cancelled' | 'partial'.
  status       String  @default("success")
  /// 1 = first try; >1 = retry / fallback to next provider.
  attempt      Int     @default(1)
  /// When this row is a retry of an earlier failed call, link back so the UI
  /// can collapse retry chains under the original attempt.
  retryOfId    String?
  /// Provider's reason for stopping: 'stop' | 'length' | 'tool_calls'
  /// | 'content_filter' | 'error' | 'cancelled'.
  finishReason String?
  errorCode    String?
  errorMessage String?

  // ── Provider request identity (debugging + dedupe) ────────────
  /// Provider's request id (Anthropic `x-request-id`, OpenAI `request-id`).
  requestId      String?
  /// Caller-supplied idempotency key (dedupe identical retries).
  idempotencyKey String?

  // ── Sampling knobs (for reproducibility / cost analysis) ──────
  temperature Float?
  maxTokens   Int?
  /// True when the response was streamed.
  streamed    Boolean @default(false)

  // ── Filtering + retention ─────────────────────────────────────
  /// Free-form labels for search / cost tagging (`feature:invoice`,
  /// `experiment:v2`, `customer:acme`, …).
  tags          String[]
  /// GDPR / compliance: how long this row should live. A nightly job purges
  /// rows whose `createdAt + retentionDays` is in the past.
  retentionDays Int      @default(365)

  /// Provider-specific extras + caller hints. Keep small (<8 KB) — anything
  /// big belongs as a column or external blob.
  metadata Json?

  // Indexes — one composite per major rollup axis. Postgres can answer
  // `GROUP BY model SUM(tokens)` against tens of millions of rows in ms when
  // (provider, model, createdAt) is indexed in that order.
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([orgId, createdAt])
  @@index([sessionId])
  @@index([traceId])
  @@index([documentId])
  @@index([sourceDocumentId])
  @@index([pipelineRunId])
  @@index([extractionId])
  @@index([analysisRunId])
  @@index([batchId])
  @@index([operation, createdAt])
  @@index([provider, model, createdAt])
  @@index([featureCode, createdAt])
  @@index([status, createdAt])
}

/// Editable per-model rate card. Cost is computed at write-time from the
/// active row (one per provider + model + unit). New prices ⇒ insert a fresh
/// row with `effectiveFrom = now()`; the previous row is closed (`effectiveTo
/// = now()`). Historical AiUsage rows reference the exact pricing row via
/// `AiUsage.pricingId` so finance can reconcile against past rate cards.
model AiModelPricing {
  id           String  @id @default(cuid())
  provider     String
  model        String
  modelVersion String?
  currency     String  @default("USD")

  /// What `unitsUsed` measures for the matching AiUsage rows.
  /// 'tokens' (LLMs) | 'pages' (LlamaParse) | 'characters' (TTS)
  /// | 'requests' (per-call flat) | 'seconds' (STT) | 'images' (vision).
  unitType String @default("tokens")

  // Per-1M-unit rates. Set the lanes that apply for this model; null = N/A.
  inputPer1M       Decimal? @db.Decimal(12, 6)
  outputPer1M      Decimal? @db.Decimal(12, 6)
  /// Anthropic cache-read input — usually a fraction of inputPer1M.
  cachedInputPer1M Decimal? @db.Decimal(12, 6)
  /// Anthropic cache-write input — usually a premium over inputPer1M.
  cacheWritePer1M  Decimal? @db.Decimal(12, 6)
  /// Reasoning / thinking tokens (o-series, Anthropic ext-thinking).
  reasoningPer1M   Decimal? @db.Decimal(12, 6)
  /// Flat fee per call (overrides per-unit math when set; or stacked on top).
  perCallUsd       Decimal? @db.Decimal(12, 6)

  /// Active rate-card validity window. Multiple rows per model are normal
  /// (price history); exactly one is active (`effectiveTo IS NULL`) at a time.
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  active        Boolean   @default(true)
  /// 'official' | 'manual' | 'imported' — provenance for the rate card.
  source        String    @default("manual")
  /// Admin notes — promo discounts, contract pricing, "to validate", …
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider, model, active])
  @@index([provider, model, effectiveFrom])
}

// ═══════════════════════════════════════════════════════════════════
// SETTINGS — generic scoped key/value store (system / org / user)
// ═══════════════════════════════════════════════════════════════════

/// Generic configuration registry. One row per (scope, scopeId, key). Lookup
/// resolves narrowest-wins: `user → org → system → built-in default in code`.
/// Used by `SettingsService.get<T>(key, { userId, orgId })` everywhere a
/// toggle / threshold / feature flag is needed — AI usage tracking, budget
/// enforcement, retention, future module switches. Add a new key by
/// registering it in `SETTING_KEYS` in code; the storage shape never
/// changes, so future phases can extend without migrations.
model Setting {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Dotted hierarchical key (e.g. `ai.usage.tracking.enabled`,
  /// `ai.usage.retention.days`, `intelligence.classify.confidence_threshold`).
  key String

  /// 'system' | 'org' | 'user'. Narrower scope wins on lookup.
  scope   String
  /// Required for org/user scope; empty string sentinel for system. Non-null
  /// so the compound unique `(scope, scopeId, key)` enforces "one override
  /// per scope+key" (Postgres treats NULL as distinct in unique indexes).
  scopeId String  @default("")

  /// JSON value — booleans, numbers, strings, arrays, objects all fit here.
  value Json

  /// Optional admin note explaining why the override exists ("disabled for
  /// EU customers", "raised retention to 730d for compliance", …).
  notes String?

  @@unique([scope, scopeId, key])
  @@index([key])
  @@index([scope, scopeId])
}

/// Soft / hard budgets per user, org, or feature. Checked before every AI call
/// by `AiUsageRecorderService.assertWithinBudget()`. Soft = warn; hard = block.
model AiBudget {
  id String @id @default(cuid())

  /// Scope: exactly one of these is set.
  userId      String?
  orgId       String?
  /// Optional feature-scoped budget (e.g. cap 'intel.extract.invoice' at $50/mo
  /// regardless of overall org budget).
  featureCode String?

  /// 'daily' | 'weekly' | 'monthly' | 'lifetime'.
  period   String  @default("monthly")
  /// Limit in USD for the period.
  limitUsd Decimal @db.Decimal(12, 2)
  /// Warn at this fraction of the limit (0..1). Sends a toast / email; doesn't block.
  warnAt   Float   @default(0.8)
  /// If true, exceeding `limitUsd` returns 402 PaymentRequired (hard cap).
  /// If false, calls are still allowed but flagged as over budget.
  hardCap  Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, active])
  @@index([orgId, active])
  @@index([featureCode, active])
}

// ═══════════════════════════════════════════════════════════════════
// LEGAL CITATION CATALOG — curated statutory references
// ═══════════════════════════════════════════════════════════════════

/// Curated statute / section reference used by:
///  • `CitationFillerService` — auto-fills `{{applicable_law}}` placeholders
///    in AI-drafted documents with the right section + a hyperlinked span.
///  • `CitationAnalyzerService` — for any saved Document, surfaces which
///    citations are present, stale (IPC/CrPC/Evidence → BNS/BNSS/BSA),
///    missing (declared via `appliesTo`), or worth pairing (`commonlyPairedWith`).
///  • Future public `/law/:id` SEO pages (out of scope for now; the table is
///    already shaped to power them via `isPublic` + `draftingTips`).
///
/// In-code `CITATIONS[]` (libs/shared/legal-reference) stays as the ultimate
/// fallback so a fresh DB still works. `LegalReferenceService` merges DB rows
/// over the code seed by `id` — DB wins. Admins extend the catalog through
/// the admin UI without redeploying.
model LegalCitation {
  /// Stable slug (e.g. `bnss.223`, `ni.138`). Doubles as the public URL slug.
  id String @id

  act      String
  actShort String?
  section  String?
  title    String
  /// 1–3 paragraph human explainer (your IP — not bare-act text).
  summary  String  @db.Text
  /// Optional bare-act text. Leave NULL unless you have rights to host it;
  /// the public page links to indiacode.nic.in instead.
  fullText    String? @db.Text
  /// Canonical-text source for the "Full text →" link.
  externalUrl String?

  effectiveFrom DateTime?
  /// Soft ref to another LegalCitation.id (the provision this one replaces,
  /// e.g. 'crpc.200' for bnss.223). Used by the analyzer's "stale → suggest
  /// successor" pass.
  supersedes String?
  /// 'high' | 'moderate' | 'low' — flagged in UI as confidence chips.
  confidence String  @default("moderate")
  /// "Verify the section number against the official bare act before binding use."
  verifyNote String?

  /// Filter / topic tags ('cheque-bounce', 'criminal', 'rti', …).
  topics             String[]
  /// Document type keys this citation applies to ('legal_notice',
  /// 'cheque_bounce', 'anticipatory_bail'). Powers `applicableFor(docTypeKey)`
  /// inside CitationFillerService + analyzer's "missing" detection.
  appliesTo          String[]
  /// Soft refs to other LegalCitation.id values that are commonly cited in
  /// the same document (e.g. ni.138 commonly paired with ni.141 + ni.142).
  /// Powers the analyzer's "suggestions[]" pass.
  commonlyPairedWith String[]
  /// Long-form advocate-grade notes for the public `/law/:id` page (when /
  /// it ships). Markdown-ish; bullet-list-friendly.
  draftingTips String? @db.Text

  /// ISO-3166-1 alpha-2 ('IN'). Future-proofing for multi-country expansion.
  jurisdiction String  @default("IN")
  isActive     Boolean @default(true)
  /// Surface on public `/law/:id` pages once they exist. Defaults to true;
  /// turn off for private / org-only citations.
  isPublic     Boolean @default(true)
  /// `null` = system / global citation; set for org-private overrides.
  ownerOrgId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jurisdiction, isActive])
  @@index([ownerOrgId])
  @@index([isPublic])
}

/// Section-grounded AI critique results, cached by (documentId, contentHash).
/// `CitationCritiqueService` first looks up the matching row by sha256 of
/// the analyzed HTML — a cache hit returns the stored issues without an AI
/// call. Re-runs on the same content cost zero tokens. Invalidates implicitly:
/// content edits change the hash, so the next critique writes a fresh row.
model CitationCritique {
  id          String   @id @default(cuid())
  documentId  String
  /// sha256 of the analyzed HTML/text.
  contentHash String
  /// Model that produced this critique (audit + cost reconciliation).
  model       String
  /// Citations the model was grounded on (mirrors CritiqueResult.groundedOn).
  groundedOn  Json
  /// CritiqueIssue[] — { category, citationId, title, detail, proposedText, severity }.
  issues      Json
  createdAt   DateTime @default(now())

  @@unique([documentId, contentHash])
  @@index([documentId, createdAt])
}
