# Next.js environment variables
# Prefix with NEXT_PUBLIC_ to expose to client-side code.

NEXT_PUBLIC_API_URL=http://localhost:5230/api

# The React SPA (apps/app) — sign-in, sign-up and the whole authenticated
# product live there. This marketing site links out to it, never hosts its
# own auth pages.
NEXT_PUBLIC_APP_URL=http://localhost:5200

# Brand name shown in the browser tab, page title template, and home hero.
NEXT_PUBLIC_SITE_NAME=Vidhi
