# ═══════════════════════════════════════════════════════════════════════════════
# @org/starter — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in ALL required values.
# Required fields have no default — the app will NOT start without them.
# Optional fields are marked (optional) — features are disabled if missing.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App (REQUIRED) ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api
PUBLIC_URL=http://localhost:3000
# Where the API redirects to after OAuth completes (the React dashboard).
FRONTEND_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200,http://localhost:4300
LOG_LEVEL=info

# ─── Cookies (REQUIRED) ─────────────────────────────────────────────────────
# Production: COOKIE_DOMAIN=.yourdomain.com  COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── JWT (REQUIRED) ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=7d

# ─── Database (REQUIRED) ────────────────────────────────────────────────────
DATABASE_URL=

# ─── OAuth: Google (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── OAuth: GitHub (optional) ───────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ─── OAuth: LinkedIn (optional) ─────────────────────────────────────────────
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# ─── Redis (optional — for mail queue, falls back to localhost:6379)
# REDIS_URL=redis://localhost:6379

# ─── Mail / SMTP (optional) ─────────────────────────────────────────────────
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com

# ─── Payment: Razorpay (optional) ───────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Payment: Stripe (optional) ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ─── React App (apps/app) — Vite ─────────────────────────────────────────────
# Per-app env lives in apps/app/.env (and apps/app/.env.example).
# VITE_API_URL=http://localhost:3000/api
# VITE_APP_URL=http://localhost:4200
# VITE_RAZORPAY_KEY_ID=

# ─── Next.js App (apps/web) ──────────────────────────────────────────────────
# Per-app env lives in apps/web/.env (and apps/web/.env.example).
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_WEB_URL=http://localhost:4300
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# Legal Documents Platform
# ═══════════════════════════════════════════════════════════════════════════════

# Internal token shared between apps/api and apps/artboard. The artboard
# /render route and the apps/api /documents/:id/render-payload endpoint
# both require this header (x-render-token). Generate any opaque random
# string of at least 32 chars. Required for PDF export to work.
# INTERNAL_RENDER_TOKEN=

# URL where the artboard is reachable from the PDF render worker.
# Dev: http://localhost:4210. Prod: deployed static-site URL.
# ARTBOARD_URL=http://localhost:4210

# URL the builder UI (apps/app) loads inside its preview iframe.
# Same value as ARTBOARD_URL for most setups; split if you serve the
# artboard from a separate domain in production.
# VITE_ARTBOARD_URL=http://localhost:4210

# ─── PDF render worker ──────────────────────────────────────────────────────
# Path to a Chrome/Chromium binary used by puppeteer-core when rendering
# PDFs. On macOS dev: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# In Docker/lambda: bundle @sparticuz/chromium and point this at its
# unpacked executable path. Required for PDF exports to work.
# PUPPETEER_EXECUTABLE_PATH=

# Optional extra args passed to Chrome at launch. JSON array or space-
# separated string. Defaults already include --no-sandbox and
# --disable-dev-shm-usage.
# PUPPETEER_LAUNCH_ARGS=["--font-render-hinting=none"]

# Redis URL is required to enqueue PDF render jobs. If unset, exports
# are rejected with a friendly error rather than silently dropping.
# REDIS_URL=redis://localhost:6379
