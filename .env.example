# ═══════════════════════════════════════════════════════════════════════════════
# @org/starter — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in ALL required values.
# Required fields have no default — the app will NOT start without them.
# Optional fields are marked (optional) — features are disabled if missing.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── App (REQUIRED) ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api
PUBLIC_URL=http://localhost:3000
# Where the API redirects to after OAuth completes (the React dashboard).
FRONTEND_URL=http://localhost:4200
CORS_ORIGIN=http://localhost:4200,http://localhost:4300
LOG_LEVEL=info

# ─── Cookies (REQUIRED) ─────────────────────────────────────────────────────
# Production: COOKIE_DOMAIN=.yourdomain.com  COOKIE_SECURE=true
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ─── JWT (REQUIRED) ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=7d

# ─── Database (REQUIRED) ────────────────────────────────────────────────────
DATABASE_URL=

# ─── OAuth: Google (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── OAuth: GitHub (optional) ───────────────────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ─── OAuth: LinkedIn (optional) ─────────────────────────────────────────────
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# ─── AI Providers (optional — at least one enables /ai, /legal-ai, /intelligence)
# AI_DEFAULT_PROVIDER picks priority order; the rest are fallbacks. Default: openai.
# AI_DEFAULT_PROVIDER=openai            # openai | claude | gemini
# AI_MODEL_WHITELIST=openai:gpt-4o-mini,claude:claude-opus-4-8   # empty = allow all
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini       # extraction over images; default = OPENAI_MODEL
# OPENAI_EMBED_MODEL=text-embedding-3-small   # RAG (Phase 2)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_VISION_MODEL=claude-opus-4-8   # reads scanned PDFs natively; default = ANTHROPIC_MODEL
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# ─── Document Intelligence: premium agentic extraction (optional) ────────────
# Vendor-agnostic hosted agentic parser (LlamaParse / Reducto / self-hosted).
# Set BASE_URL + API_KEY to enable the premium extraction tier (Feature.premium_extraction).
# EXTRACTION_AGENTIC_BASE_URL=https://api.your-agentic-parser.com/v1/parse
# EXTRACTION_AGENTIC_API_KEY=...
# EXTRACTION_AGENTIC_MODEL=               # optional model/preset sent in the body
# EXTRACTION_AGENTIC_RESPONSE_PATH=markdown   # dot-path to text in the JSON response
# EXTRACTION_AGENTIC_PROVIDER=llamaparse  # label for telemetry

# ─── Redis (optional — for mail queue, falls back to localhost:6379)
# REDIS_URL=redis://localhost:6379

# ─── Mail / SMTP (optional) ─────────────────────────────────────────────────
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com

# ─── Payment: Razorpay (optional) ───────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Payment: Stripe (optional) ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ─── React App (apps/app) — Vite ─────────────────────────────────────────────
# Per-app env lives in apps/app/.env (and apps/app/.env.example).
# VITE_API_URL=http://localhost:3000/api
# VITE_APP_URL=http://localhost:4200
# VITE_RAZORPAY_KEY_ID=

# ─── Next.js App (apps/web) ──────────────────────────────────────────────────
# Per-app env lives in apps/web/.env (and apps/web/.env.example).
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_WEB_URL=http://localhost:4300
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ═══════════════════════════════════════════════════════════════════════════════
# Legal Documents Platform
# ═══════════════════════════════════════════════════════════════════════════════

# Internal token shared between apps/api and apps/artboard. The artboard
# /render route and the apps/api /documents/:id/render-payload endpoint
# both require this header (x-render-token). Generate any opaque random
# string of at least 32 chars. Required for PDF export to work.
# INTERNAL_RENDER_TOKEN=

# URL where the artboard is reachable from the PDF render worker.
# Dev: http://localhost:4210. Prod: deployed static-site URL.
# ARTBOARD_URL=http://localhost:4210

# URL the builder UI (apps/app) loads inside its preview iframe.
# Same value as ARTBOARD_URL for most setups; split if you serve the
# artboard from a separate domain in production.
# VITE_ARTBOARD_URL=http://localhost:4210

# ─── PDF render worker ──────────────────────────────────────────────────────
# Pick ONE of two Chrome acquisition modes. Remote takes priority if both
# are set.
#
# (a) Remote — Browserless / chrome-headless-shell over WebSocket.
#     Recommended for dev; no local Chrome install needed.
#     `docker run -p 8080:3000 ghcr.io/browserless/chrome` then:
# CHROME_URL=ws://localhost:8080
# CHROME_TOKEN=your-browserless-token
# CHROME_IGNORE_HTTPS_ERRORS=true
#
# Networking gotcha: from inside the Browserless container, "localhost"
# is the container, not your host. The renderer auto-rewrites
# ARTBOARD_URL hostnames "localhost"/"127.0.0.1" → "host.docker.internal"
# whenever CHROME_URL is set (macOS/Windows Docker Desktop). On Linux
# either pass --add-host=host.docker.internal:host-gateway to docker run
# OR set ARTBOARD_URL=http://<host-LAN-IP>:4210 to override.
#
# (b) Local — point puppeteer-core at a Chrome/Chromium binary.
#     On macOS dev:
#     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#     In Docker/lambda: bundle @sparticuz/chromium and point this at its
#     unpacked executable path.
# PUPPETEER_EXECUTABLE_PATH=
# Optional extra args (only used in local mode). JSON array or space-
# separated. Defaults already include --no-sandbox and
# --disable-dev-shm-usage.
# PUPPETEER_LAUNCH_ARGS=["--font-render-hinting=none"]

# Redis URL enables BullMQ for PDF render jobs (retries, scaling). If
# unset, renders run inline in the API process — fine for dev, not for
# production load.
# REDIS_URL=redis://localhost:6379

# ─── Storage ────────────────────────────────────────────────────────────────
# S3-compatible backend (MinIO works). When ANY of ENDPOINT/ACCESS_KEY/
# SECRET_KEY is missing, the StorageService falls back to a local-fs
# backend that writes under STORAGE_LOCAL_ROOT (default: `.storage-local/`
# in the API's cwd) and serves files via GET /api/storage/local/{key}.
# Dev only — production must configure S3.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=uploads
# STORAGE_PUBLIC_URL=http://localhost:9000
# STORAGE_LOCAL_ROOT=./.storage-local
