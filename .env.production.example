# ═══════════════════════════════════════════════════════════════════════════════
# Vidhi — PRODUCTION env for the single-VPS Docker deployment.
# Copy to `.env` next to docker-compose.yml and fill EVERY required value.
#   cp .env.production.example .env
# Generate secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Domain + TLS (Caddy) ────────────────────────────────────────────────────
# Apex domain only (no scheme). Caddy serves: apex→web, app.→app, api.→api,
# art.→artboard, storage.→minio. Change this ONE value to point the whole
# stack at a different domain — nothing else in this file is domain-specific
# except the URLs derived from it below (which you still need to edit to match).
DOMAIN=doclio.in
ACME_EMAIL=admin@doclio.in
# Caddy uses this to issue/renew certs via Cloudflare DNS-01 — works even while
# every subdomain stays Proxied (orange cloud) in Cloudflare, since it never
# needs live traffic to reach the origin. Generate at:
#   Cloudflare dashboard → My Profile → API Tokens → Create Token →
#   "Edit zone DNS" template → scope to the {$DOMAIN} zone only
#   (not the account-wide Global API Key).
# Not using Cloudflare? Delete this + the acme_dns line in docker/Caddyfile —
# Caddy falls back to HTTP-01 (needs the subdomain DNS-only during issuance).
CLOUDFLARE_API_TOKEN=CHANGE_ME

# ─── Public URLs (must match the subdomains above) ───────────────────────────
PUBLIC_URL=https://api.doclio.in
FRONTEND_URL=https://app.doclio.in

# CORS allow-list — the marketing apex + the app subdomain.
CORS_ORIGIN=https://doclio.in,https://app.doclio.in

# ─── Frontend build-time vars (inlined into the bundles at image build) ──────
NEXT_PUBLIC_SITE_NAME=Vidhi
NEXT_PUBLIC_API_URL=https://api.doclio.in/api
NEXT_PUBLIC_APP_URL=https://app.doclio.in
NEXT_PUBLIC_WEB_URL=https://doclio.in
NEXT_PUBLIC_RAZORPAY_KEY_ID=

VITE_APP_NAME=Vidhi
VITE_API_URL=https://api.doclio.in/api
VITE_APP_URL=https://app.doclio.in
VITE_WEB_URL=https://doclio.in
VITE_ARTBOARD_URL=https://art.doclio.in
VITE_RAZORPAY_KEY_ID=

# ─── Cookies (shared SSO across *.doclio.in) ─────────────────────────────────
# The leading dot makes the auth cookie valid on apex + app + api subdomains.
COOKIE_DOMAIN=.doclio.in
COOKIE_SECURE=true

# ─── Passkeys / WebAuthn (optional overrides) ────────────────────────────────
# Left unset, the RP ID/origin are derived from FRONTEND_URL
# (app.doclio.in) — correct for the default topology above. Only set these if
# you want credentials to work across a domain FRONTEND_URL doesn't cover
# (e.g. pin WEBAUTHN_RP_ID to the apex "doclio.in" instead of "app.doclio.in").
# WEBAUTHN_RP_ID=
# WEBAUTHN_RP_NAME=Vidhi
# WEBAUTHN_ORIGIN=

# ─── JWT secrets (REQUIRED — generate unique values) ─────────────────────────
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_TTL=7d

# ─── Database (Postgres container) ───────────────────────────────────────────
# POSTGRES_PASSWORD must match the password inside DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=vidhi
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_db_password@postgres:5432/vidhi

# ─── Redis (container) ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Object storage: MinIO (container) — uploads + rendered documents ────────
# Root user/password double as the API's S3 credentials (single-tenant
# deployment, see docker-compose.yml). STORAGE_PUBLIC_URL is the public HTTPS
# host browsers fetch files from (routed through Caddy — needs a DNS A-record
# for storage.{DOMAIN}, same as the other subdomains). STORAGE_ENDPOINT is left
# at its docker-compose default (http://minio:9000, internal-only).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
STORAGE_PUBLIC_URL=https://storage.doclio.in
STORAGE_BUCKET=uploads

# ─── PDF render worker ────────────────────────────────────────────────────────
CHROME_URL=ws://chrome:3000
# Opaque token shared between apps/api and apps/artboard for the internal
# render-payload fetch (x-render-token). Required for PDF export to work.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_RENDER_TOKEN=CHANGE_ME

# ─── Estate & Wealth Vault module (docs/13) ──────────────────────────────────
# 'false' mounts no controllers/scheduler and hides the nav for this
# deployment — zero runtime surface, no data loss (tables untouched).
ESTATE_VAULT_ENABLED=true

# ─── Billing / quota enforcement ─────────────────────────────────────────────
# 'false' lets every request through regardless of wallet/usage state — useful
# while pricing tiers are still being validated, before flipping this on.
BILLING_ENFORCED=true

# ─── First admin (one-time seed — REQUIRED to reach /config in production) ──
# tools/prisma/seed.ts bootstraps this account idempotently on `pnpm prisma:seed`
# (run automatically the first time via the runbook in docs/DEPLOYMENT.md).
# Without this, there is no way to reach role === 'admin' except a manual DB edit.
ADMIN_EMAIL=admin@doclio.in
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin

# ─── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── OAuth (optional — only shown on login if BOTH id+secret are set) ────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://api.doclio.in/api/auth/google/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://api.doclio.in/api/auth/github/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_CALLBACK_URL=https://api.doclio.in/api/auth/linkedin/callback

# ─── Mail / SMTP (optional) ──────────────────────────────────────────────────
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@doclio.in

# ─── Payments: Razorpay (optional) ───────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ─── Payments: Stripe (optional) ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ─── AI providers (set at least ONE key to enable /ai, /legal-ai, /intelligence) ──
AI_DEFAULT_PROVIDER=claude
AI_MODEL_WHITELIST=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_VISION_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
OPENAI_EMBED_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# ─── Document Intelligence: premium agentic extraction (optional) ───────────
# EXTRACTION_AGENTIC_BASE_URL=
# EXTRACTION_AGENTIC_API_KEY=
# EXTRACTION_AGENTIC_MODEL=
# EXTRACTION_AGENTIC_RESPONSE_PATH=markdown
# EXTRACTION_AGENTIC_PROVIDER=
